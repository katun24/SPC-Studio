<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:SpcStudio.Theme"
        xmlns:app="using:SpcStudio"
        xmlns:controls="using:SpcStudio.Controls"
        x:Class="SpcStudio.SamplePathDialog"
        Title="{x:Static app:WindowTitles.SamplePath}">
    <StackPanel Classes="dialogBody" MinWidth="320">
        <SelectableTextBlock x:Name="MessageText" Classes="dialogMessage"/>
        <TextBox x:Name="PathBox" Margin="{theme:SpaceThickness Top={x:Static theme:Space.Px12}}"
                 controls:FieldInput.Accepts="DiskName"
                 HorizontalAlignment="Stretch"
                 TextChanged="OnPathChanged"/>
        <controls:ConfirmButtonRow x:Name="ButtonRow" ConfirmClick="OnOkClick" CancelClick="OnDismissClick"/>
    </StackPanel>
</Window>
