<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:SpcStudio"
        xmlns:controls="using:SpcStudio.Controls"
        x:Class="SpcStudio.PreferencesWindow"
        Title="{x:Static app:WindowTitles.Preferences}">
    <StackPanel Classes="dialogBody dialogSections">
        <controls:TopLabeledSetting Label="AddmusicK Folder">
            <controls:PathPickRow x:Name="AmkFolderRow" Classes="settingPath"/>
        </controls:TopLabeledSetting>
        <controls:TopLabeledSetting Label="ROM">
            <controls:PathPickRow x:Name="RomPathRow" Classes="settingPath"/>
        </controls:TopLabeledSetting>
        <Border Classes="panelRule"/>
        <controls:TopLabeledSetting Label="Output Device">
            <ComboBox x:Name="OutputDeviceBox" HorizontalAlignment="Stretch"/>
        </controls:TopLabeledSetting>
        <Border Classes="panelRule"/>
        <controls:SettingSlider x:Name="DragScrollSetting" SettingName="Drag Scroll Speed" TickFrequency="1"/>
        <controls:SettingSlider x:Name="ZoomSpeedSetting" SettingName="Zoom Speed" TickFrequency="5"/>
        <Border Classes="panelRule"/>
        <StackPanel Classes="settingCheckBoxes">
            <CheckBox x:Name="OpenMmlBox" Content="Open MML After Export"/>
            <CheckBox x:Name="SmwOriginalsBox" Content="Include SMW's Original Songs In ROM Extraction"/>
            <CheckBox x:Name="UpdateCheckBox" Content="Check For Updates At Launch"/>
        </StackPanel>
        <controls:CloseButton Click="OnDismissClick"/>
    </StackPanel>
</Window>
