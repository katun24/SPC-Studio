<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:SpcStudio.Theme"
        x:Class="SpcStudio.ProgressDialog"
        SizeToContent="Height" Width="320">
    <StackPanel Classes="dialogBody">
        <SelectableTextBlock x:Name="StageText"/>
        <Border Margin="{theme:SpaceThickness Top={x:Static theme:Space.Px12}}" Height="10" CornerRadius="5"
                Background="{StaticResource SunkenBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid x:Name="BarColumns" ColumnDefinitions="0*,1*">
                <Border Grid.Column="0" CornerRadius="4"
                        Background="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>
        <StackPanel Classes="dialogButtonRow" Margin="{theme:SpaceThickness Top={x:Static theme:Space.Px16}}">
            <Button x:Name="CancelButton" Content="Cancel" Classes="dialogButton"
                    Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
